# Cube with CW winding (1x1x1)

o Cube
v -0.5 -0.5  0.5  # 1 front-bottom-left
v  0.5 -0.5  0.5  # 2 front-bottom-right
v  0.5  0.5  0.5  # 3 front-top-right
v -0.5  0.5  0.5  # 4 front-top-left
v -0.5 -0.5 -0.5  # 5 back-bottom-left
v  0.5 -0.5 -0.5  # 6 back-bottom-right
v  0.5  0.5 -0.5  # 7 back-top-right
v -0.5  0.5 -0.5  # 8 back-top-left

# Front face (z = +0.5)
f 1 3 2
f 1 4 3

# Back face (z = -0.5)
f 6 8 5
f 6 7 8

# Left face (x = -0.5)
f 5 4 1
f 5 8 4

# Right face (x = +0.5)
f 2 7 6
f 2 3 7

# Top face (y = +0.5)
f 4 7 3
f 4 8 7

# Bottom face (y = -0.5)
f 5 2 6
f 5 1 2
